{
  "name": "@dallanj/pinia-hydrate",
  "version": "0.2.0",
  "description": "Explicit Pinia hydration from versioned server payloads",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallanj/pinia-hydrate.git",
    "directory": "packages/javascript"
  },
  "homepage": "https://github.com/dallanj/pinia-hydrate#readme",
  "bugs": {
    "url": "https://github.com/dallanj/pinia-hydrate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "vite build && tsc",
    "format": "prettier --write .",
    "format:test": "prettier --check .",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "pinia": "^2.0.0 || ^3.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "pinia": "^3.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0"
  }
}
